# Môi trường: dev | prod
ENV=dev
# SQLite khi phát triển; PostgreSQL khi triển khai (vd Neon: postgres://user:pass@host/db)
# Dùng PostgreSQL thì cài thêm: python -m pip install -r requirements-postgres.txt
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# BẮT BUỘC đổi khi chạy thật: một chuỗi ngẫu nhiên dài (python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=dev-secret-change-me-0123456789abcdef
# Chỉ dev: 1440 = một ngày SRS trôi qua trong một phút
TIME_SCALE=1
# Chỉ dev: "dev" = số liệu thử nhanh (server/data/balance/dev/*.json đè lên balance thật)
BALANCE_PROFILE=
# Cho phép câu ví dụ / câu luyện tập chưa duyệt (mặc định bật ở dev, tắt ở prod)
ALLOW_UNREVIEWED=1
AUTO_MIGRATE=1
DB_POOL_SIZE=3
# Bật khi chạy sau reverse proxy (Caddy, Cloudflare Tunnel) để lấy đúng IP người chơi
TRUST_PROXY_HEADERS=0
MAINTENANCE_MESSAGE=
# Số tài khoản mới tối đa mỗi IP mỗi ngày (bỏ trống = theo balance/economy.json, mặc định 5).
# Chỉ tăng khi thử tải bằng tools/load_bots.py.
ACCOUNTS_PER_IP=
# Giai đoạn 10: tài khoản quản trị (gõ /admin trong chat), cách nhau bằng dấu phẩy
ADMIN_USERNAMES=
# Link tải game và phiên bản exe mới nhất, hiện ở /server/info và trong game
CLIENT_DOWNLOAD_URL=
LATEST_CLIENT_VERSION=
# PostgreSQL: đóng kết nối rảnh sau chừng này giây để Neon được tạm dừng (0 = không bao giờ)
DB_IDLE_CLOSE_SECONDS=300
