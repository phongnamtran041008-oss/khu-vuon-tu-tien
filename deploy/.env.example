# Chép thành deploy/.env rồi sửa. Không đưa file .env lên GitHub.

# Mật khẩu PostgreSQL: chỉ dùng chữ và số (nó nằm trong một URL).
#   python -c "import secrets;print(secrets.token_hex(16))"
POSTGRES_PASSWORD=doi-mat-khau-nay

# BẮT BUỘC: chuỗi ngẫu nhiên dài để ký token đăng nhập.
#   python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=

# Phương án A: tên miền trỏ về IP máy (vd vuonchu.duckdns.org). Caddy tự lấy HTTPS.
DOMAIN=

ENV=prod
# Đứng sau Caddy / Cloudflare Tunnel: lấy IP thật của người chơi (giới hạn 5 tài khoản/IP/ngày)
TRUST_PROXY_HEADERS=1
# Câu ví dụ do AI viết chưa được duyệt hết (tools/apply_review.py). Đặt 0 khi đã duyệt xong.
ALLOW_UNREVIEWED=1
DB_POOL_SIZE=3

# Tài khoản quản trị (cách nhau bằng dấu phẩy): có quyền gõ /admin trong chat.
ADMIN_USERNAMES=
# Hiện ở /server/info và trong game khi có bản mới
CLIENT_DOWNLOAD_URL=https://github.com/<tai-khoan>/<repo>/releases/latest
LATEST_CLIENT_VERSION=1.1.0
# Thông báo bảo trì lúc khởi động (đổi được trong game bằng /admin maintenance ...)
MAINTENANCE_MESSAGE=

# Sao lưu: giữ bao nhiêu bản, chạy lúc mấy giờ UTC (20 = 3 giờ sáng Việt Nam). File ở deploy/backups/
BACKUP_KEEP=7
BACKUP_HOUR_UTC=20

# Dùng image dựng sẵn từ GitHub (.github/workflows/docker.yml) thay vì build trên máy:
# SERVER_IMAGE=ghcr.io/<tai-khoan>/khu-vuon-tu-tien-server:latest
